datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ADMIN_PANEL
  DRIVER
  TOKEN_MANAGER
  EMPLOYEE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  CONFIRMED
  REJECTED
}

enum ProjectName {
  UG               @map("UG")
  UB               @map("UB")
  BAYAJUULAH       @map("Баяжуулах")
  PROJECT          @map("Төсөл")
  OPERATION        @map("operation")
  CONTRACTION      @map("contraction")
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  LOGIN
}

model User {
  id            String         @id @default(uuid())
  sapId         String?        @unique
  firstName     String
  lastName      String
  phoneNumber   String
  ProjectName   ProjectName    @default(UG)
  passwordHash  String
  role          Role           @default(EMPLOYEE)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vehicles      Vehicle[]
  requests      RepairRequest[]
  orders        MerchOrder[]
  confirmedOrders MerchOrder[] @relation("ConfirmedOrders")
  rejectedOrders MerchOrder[] @relation("RejectedOrders")
  refreshTokens RefreshToken[]
  notifications Notification[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Vehicle {
  id               String          @id @default(uuid())
  name             String
  type             String          @default("Unspecified")
  plate            String          @unique
  department       String          @default("Unassigned")
  assignedDriverId String?
  driver           User?           @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  parts            Part[]
  requests         RepairRequest[]
}

model Part {
  id           String          @id @default(uuid())
  name         String
  categoryId   String?
  categoryName String?
  vehicleId    String?
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  isGlobal     Boolean         @default(false)
  requests     RepairRequest[]
  requestParts RequestPart[]
}

model RepairRequest {
  id            String         @id @default(uuid())
  driverId      String
  driver        User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  partId        String?
  part          Part?          @relation(fields: [partId], references: [id], onDelete: SetNull)
  description   String
  status        RequestStatus  @default(PENDING)
  isReadByAdmin Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        RequestImage[]
  requestParts  RequestPart[]
}

model RequestPart {
  requestId String
  partId    String
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  part      Part          @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([requestId, partId])
  @@index([partId])
}

model RequestImage {
  id        String        @id @default(uuid())
  requestId String
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url       String
}

model MerchItem {
  id              String       @id @default(uuid())
  title           String
  description     String
  longDescription String
  price           Float
  stock           Int
  sizes           String[]
  colors          String[]
  imageUrl        String
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orders          MerchOrder[]
}

model MerchOrder {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchItemId      String
  merchItem        MerchItem   @relation(fields: [merchItemId], references: [id], onDelete: Cascade)
  size             String
  color            String
  qty              Int
  status           OrderStatus @default(NEW)
  isReadByManager  Boolean     @default(false)
  orderedAt        DateTime    @default(now())
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedBy      User?       @relation("ConfirmedOrders", fields: [confirmedById], references: [id], onDelete: SetNull)
  rejectedAt       DateTime?
  rejectedById     String?
  rejectedBy       User?       @relation("RejectedOrders", fields: [rejectedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OtpVerification {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  code        String   // Хэрэглэгч рүү илгээсэн OTP кодын hash утга
  purpose     OtpPurpose
  expiresAt   DateTime // Код хүчинтэй байх хугацаа дуусах цэг
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PendingRegistration {
  id          String      @id @default(uuid())
  phoneNumber String      @unique
  sapId       String?
  firstName   String
  lastName    String
  ProjectName ProjectName
  passwordHash String
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}