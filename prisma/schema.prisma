datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}
enum Role {
  SUPERADMIN
  ADMIN
  ADMIN_PANEL
  DRIVER
  TOKEN_MANAGER
  EMPLOYEE
  HR
}
enum RequestStatus {
  PENDING
  SEARCHING
  ORDERED
  NOT_FOUND
  COMPLETED
}
enum OrderStatus {
  NEW
  PENDING
  SEARCHING
  NOT_FOUND
  COMPLETED
  CONFIRMED
  REJECTED
}
enum ProjectName {
  UG               @map("UG")
  UB               @map("UB")
  BAYAJUULAH       @map("Баяжуулах")
  PROJECT
  OPERATION        @map("operation")
  CONTRACTION      @map("contraction")
  OTHER
}
enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  LOGIN
}
enum FeedbackStatus {
  PENDING
  RESOLVED
  SUSPENDED
}
enum FeedbackCategory {
  WORKPLACE
  OPERATIONS
  MANAGEMENT
  COMPENSATION
  OTHER
}
enum LeaveType {
  SICK
  PERSONAL
  OTHER
}
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
enum LeaveDurationType {
  DAILY
  HOURLY
}
enum LeaveApprovalLevel {
  SENIOR_SPECIALIST
  UNIT_MANAGER
  HR_DIRECTOR
  GENERAL_DIRECTOR
}
model User {
  id                   String          @id @default(uuid())
  sapId                String?         @unique
  firstName            String
  lastName             String
  phoneNumber          String          @unique
  profileImage         String?
  profileImagePublicId String?
  ProjectName          ProjectName     @default(UG)
  passwordHash         String
  role                 Role            @default(EMPLOYEE)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  vehicles             Vehicle[]
  requests             RepairRequest[]
  assignedRequests     RepairRequest[] @relation("AssignedRequests")
  orders               MerchOrder[]
  calendarNotes        CalendarNote[]
  confirmedOrders      MerchOrder[]    @relation("ConfirmedOrders")
  rejectedOrders       MerchOrder[]    @relation("RejectedOrders")
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  feedbacks            Feedback[]
  leaveRequests        LeaveRequest[]  @relation("LeaveRequests")
  reviewedLeaveRequests LeaveRequest[] @relation("ReviewedLeaveRequests")
}
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Vehicle {
  id               String          @id @default(uuid())
  name             String
  type             String          @default("Unspecified")
  plate            String          @unique
  department       String          @default("Unassigned")
  assignedDriverId String?
  driver           User?           @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  parts            Part[]
  requests         RepairRequest[]
}
model Part {
  id           String          @id @default(uuid())
  name         String
  categoryId   String?
  categoryName String?
  vehicleId    String?
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  isGlobal     Boolean         @default(false)
  requests     RepairRequest[]
  requestParts RequestPart[]
}
model RepairRequest {
  id            String         @id @default(uuid())
  driverId      String
  driver        User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  partId        String?
  part          Part?          @relation(fields: [partId], references: [id], onDelete: SetNull)
  description   String
  status        RequestStatus  @default(PENDING)
  assignedAdminId String?
  assignedAdmin User? @relation("AssignedRequests", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  isReadByAdmin Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        RequestImage[]
  requestParts  RequestPart[]

  @@index([assignedAdminId])
}

model RequestPart {
  requestId String
  partId    String
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  part      Part          @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([requestId, partId])
  @@index([partId])
}

model RequestImage {
  id        String        @id @default(uuid())
  requestId String
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url       String
}

model MerchItem {
  id              String       @id @default(uuid())
  title           String
  description     String
  longDescription String
  price           Float
  stock           Int
  sizes           String[]
  colors          String[]
  imageUrl        String
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orders          MerchOrder[]
}

model MerchOrder {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchItemId      String
  merchItem        MerchItem   @relation(fields: [merchItemId], references: [id], onDelete: Cascade)
  size             String
  color            String
  qty              Int
  status           OrderStatus @default(NEW)
  isReadByManager  Boolean     @default(false)
  orderedAt        DateTime    @default(now())
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedBy      User?       @relation("ConfirmedOrders", fields: [confirmedById], references: [id], onDelete: SetNull)
  rejectedAt       DateTime?
  rejectedById     String?
  rejectedBy       User?       @relation("RejectedOrders", fields: [rejectedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime    @updatedAt
}

model MerchPartner {
  id           String   @id
  title        String
  description  String   @default("")
  logo         String   @default("")
  logoPublicId String?
  secondaryLogo String?
  secondaryLogoPublicId String?
  url          String   @default("")
  ctaLabel     String   @default("Дэлгэрэнгүй")
  footerText   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model Feedback {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    FeedbackCategory @default(OTHER)
  message     String
  status      FeedbackStatus   @default(PENDING)
  response    String?
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([userId])
}

model LeaveRequest {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation("LeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  type         LeaveType          @default(OTHER)
  durationType LeaveDurationType  @default(DAILY)
  startDate    DateTime
  endDate      DateTime
  reason       String
  proofImageUrl String
  selectedApproverPhoneNumber String?
  selectedApproverName String?
  selectedHrPhoneNumber String?
  selectedHrName String?
  status       LeaveRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?              @relation("ReviewedLeaveRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([selectedApproverPhoneNumber, createdAt])
}

model OtpVerification {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  code        String   // Хэрэглэгч рүү илгээсэн OTP кодын hash утга
  purpose     OtpPurpose
  expiresAt   DateTime // Код хүчинтэй байх хугацаа дуусах цэг
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PendingRegistration {
  id          String      @id @default(uuid())
  phoneNumber String      @unique
  sapId       String?
  firstName   String
  lastName    String
  ProjectName ProjectName
  passwordHash String
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Whitelist {
  id          String      @id @default(uuid())
  phoneNumber String      @unique
  projectName ProjectName
  leaveRequestApproverOverrideName        String?
  leaveRequestApproverOverridePhoneNumber String?
  isConstructionDepartment                Boolean     @default(false)
  leaveRequestAccess LeaveRequestAccess[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model LeaveRequestAccess {
  phoneNumber     String
  whitelist       Whitelist            @relation(fields: [phoneNumber], references: [phoneNumber], onDelete: Cascade)
  displayName     String               @default("")
  projectName     ProjectName
  canView         Boolean              @default(false)
  canApprove      Boolean              @default(false)
  approvalLevel   LeaveApprovalLevel?
  isResponsibleHr Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@id([phoneNumber, projectName])
  @@index([projectName, canView])
  @@index([projectName, canApprove])
}

model CalendarNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteDate  String
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, noteDate])
}